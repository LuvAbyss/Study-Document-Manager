rules_version = '2';

// Cấu trúc lưu trữ vật lý trên Firebase Storage:
// /users/{ownerUid}/subjects/{subjectId}/documents/{documentId}/{fileName}
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{ownerUid}/subjects/{subjectId}/documents/{documentId}/{fileName} {
      // Chủ sở hữu có toàn quyền Đọc / Ghi / Xóa tệp tin vật lý
      // Người dùng đã xác thực qua Firebase Auth có quyền tải tệp nếu được cấp quyền trên Supabase
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
                           && (request.auth.uid == ownerUid
                               || request.resource.metadata['editorUid'] == request.auth.uid);
    }
  }
}
